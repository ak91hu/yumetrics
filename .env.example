# Másold .env névre. Ne tedd Gitbe a valódi kulcsokat!
# Részletes kulcslista és beszerzés: docs/API-KEYS.md
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
# Éles Northflank runtime érték: APP_ORIGIN=https://yumetrics.app
HOST=127.0.0.1
PORT=3000

# Brevo SMTP: a jelszó az SMTP-kulcs (nem a REST API-kulcs).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Brevóban hitelesített feladócím, pl. Yumetrics <hello@yumetrics.app>
SMTP_FROM=
WEEKLY_REPORTS_ENABLED=true

# Northflank PostgreSQL addon kapcsolati URL-je. A jelszót tartalmazó URL titkos!
DATABASE_URL=

# Google Cloud Console → OAuth 2.0 Client ID → Web application
# Authorized redirect URI: http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionális külső visszatérő oldal. Üresen az APP_ORIGIN/auth/google/callback használatos.
GOOGLE_REDIRECT_URI=

# https://opencode.ai/console → saját workspace API key
OPENCODE_API_KEY=
# GPT-6 Luna az OpenCode OpenAI Responses végpontján, ugyanazzal a kulccsal. Gemini/Haiku is választható.
OPENCODE_MODEL=gpt-6-luna
# Luna gondolkodási szint: none | low | medium | high | max.
LUNA_REASONING_EFFORT=low
# A modell a Cloudinaryban tárolt eredeti fotó aláírt, kicsinyített másolatát kapja (hosszabb oldal, px; 512–4096).
MODEL_IMAGE_MAX_SIDE=1600
# Egy kérés teljes kimeneti kerete (válasz + gondolkodás). Luna: 1000–4000, Gemini: 1000–1600.
AI_MAX_OUTPUT_TOKENS=3000
# Admin HUF-becsléshez használt tervezési árfolyam, nem élő banki árfolyam.
AI_USD_HUF=328.16

# Opcionális Food-R1 tartalék: csak erősen bizonytalan ételazonosságnál, Gemini UTÁN.
# Legfeljebb egy segédhívás; nincs második Gemini-kérés vagy automatikus javítókör.
# Üres végponttal csak OpenCode fut. Kizárólag hitelesített *.modal.run/recognize cím.
MODAL_FOOD_URL=
# Proxy token (wk-/ws-), nem a telepítési kliens ak-/as- API-tokenje.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Belső havi becsült keret USD-ben; 0: a segéd kikapcsolása. Nem szolgáltatói költési plafon.
MODAL_MONTHLY_BUDGET_USD=15
# Eszkalációnál a Food-R1 második becslésének megengedett relatív eltérése (δ). Üresen a mért érték,
# ennek hiányában 0,25. Csak tudatos felülíráshoz add meg.
# FOOD_R1_DELTA=
# https://console.cloudinary.com → Product Environment / Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionális: TypeSafe Jev döntési réteg (https://console.typesafe.ai/home → API keys).
# Csak zárt döntéseket hoz (ételcsoport, adatbázis-tétel, elkészítés, kapuk); kalóriát nem számol.
# Üresen a korábbi, pontos egyezéses folyamat fut. Csak backend-titok, a webappba nem kerülhet.
JEV_API=
# Rögzített modellverzió; a jev-latest alias nem engedélyezett.
JEV_MODEL=jev-1.14.0
# Bizonyossági küszöbök (θ). Üresen a mért érték (lib/jev-calibration.json, scripts/calibrate-jev.mjs) érvényes,
# ennek hiányában 0,6. Csak tudatos felülíráshoz add meg.
# JEV_DISH_THRESHOLD=
# JEV_ITEM_THRESHOLD=

# Opcionális: FoodData Central referenciakeresés. Nem használunk DEMO_KEY-t futás közben.
# https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=

# Ingyenes adat-API-k, további LLM-hívás nélkül. 0: külső lekérések kikapcsolása.
# USDA élőkereséshez saját ingyenes kulcs kell; hiányában a többi forrás működik.
# CNF, svéd, norvég és Open Food Facts olvasáshoz nincs kulcs.
FREE_FOOD_APIS=1
FREE_FOOD_SOURCES=usda,cnf,slv,matvare,off
# A szerver 12 másodperces közös adatlekérési időkeretet, legfeljebb 16 hálózati
# kérést és tartós gyorsítótárat használ. Nem adja át a fotókat/megjegyzéseket az adat-API-knak.
