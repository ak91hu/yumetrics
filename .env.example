# Másold .env névre. Ne tedd Gitbe a valódi kulcsokat!
# Részletes kulcslista és beszerzés: docs/API-KEYS.md
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
# Éles Northflank runtime érték: APP_ORIGIN=https://yumetrics.app
HOST=127.0.0.1
PORT=3000

# Northflank PostgreSQL addon kapcsolati URL-je. A jelszót tartalmazó URL titkos!
DATABASE_URL=

# Google Cloud Console → OAuth 2.0 Client ID → Web application
# Authorized redirect URI: http://127.0.0.1:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionális külső visszatérő oldal. Üresen az APP_ORIGIN/auth/google/callback használatos.
GOOGLE_REDIRECT_URI=

# https://opencode.ai/console → saját workspace API key
OPENCODE_API_KEY=
OPENCODE_MODEL=gemini-3.5-flash-lite
# Alapesetben egyetlen Gemini-kérés; utána ingyenes adatforrások és helyi számítás.
# Egy kérés teljes kimeneti kerete (válasz + gondolkodás), 1000–1600.
AI_MAX_OUTPUT_TOKENS=1600
# Admin HUF-becsléshez használt tervezési árfolyam, nem élő banki árfolyam.
AI_USD_HUF=328.16

# Opcionális Food-R1 tartalék: csak erősen bizonytalan ételazonosságnál, Gemini UTÁN.
# Legfeljebb egy segédhívás; nincs második Gemini-kérés vagy automatikus javítókör.
# Üres végponttal csak OpenCode fut. Kizárólag hitelesített *.modal.run/recognize cím.
MODAL_FOOD_URL=
# Proxy token (wk-/ws-), nem a telepítési kliens ak-/as- API-tokenje.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Belső havi becsült keret USD-ben; 0: a segéd kikapcsolása. Nem szolgáltatói költési plafon.
MODAL_MONTHLY_BUDGET_USD=15
# https://console.cloudinary.com → Product Environment / Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionális: FoodData Central referenciakeresés. Nem használunk DEMO_KEY-t futás közben.
# https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=

# Ingyenes adat-API-k, további LLM-hívás nélkül. 0: külső lekérések kikapcsolása.
# USDA élőkereséshez saját ingyenes kulcs kell; hiányában a többi forrás működik.
# CNF, svéd, norvég és Open Food Facts olvasáshoz nincs kulcs.
FREE_FOOD_APIS=1
FREE_FOOD_SOURCES=usda,cnf,slv,matvare,off
# A szerver 12 másodperces közös adatlekérési időkeretet, legfeljebb 16 hálózati
# kérést és tartós gyorsítótárat használ. Nem adja át a fotókat/megjegyzéseket az adat-API-knak.
