# Másold .env névre. Ne tedd Gitbe a valódi kulcsokat!
OPENCODE_API_KEY=
OPENCODE_MODEL=gemini-3.8-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alapértelmezésben csak ezen a gépen érhető el.
HOST=127.0.0.1
PORT=3000
# Hálózati / mobilos eléréshez kötelező erős jelszó és a külső eredet.
APP_PASSWORD=
APP_ORIGIN=
# Opcionális: tartós lemezre mutató abszolút SQLite-útvonal.
# DATABASE_PATH=C:/Yumetrics/data/yumetrics.sqlite
